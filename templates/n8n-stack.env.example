# n8n Self-Service Provisioning — .env template (from Steward, 2026-09-01)
# Per-account values are marked <<CHANGES PER ACCOUNT>>; everything else is static.

N8N_PORT=32783                                          # <<CHANGES PER ACCOUNT>> next free port on chosen environment (verify against live containers, +1 from highest)
N8N_HOST=username.steprotech.com                        # <<CHANGES PER ACCOUNT>> username chosen by user, else derived from their email
N8N_PROTOCOL=https
WEBHOOK_URL=https://username.steprotech.com/            # <<CHANGES PER ACCOUNT>> follows N8N_HOST
N8N_EDITOR_BASE_URL=https://username.steprotech.com/    # <<CHANGES PER ACCOUNT>> follows N8N_HOST
N8N_ENCRYPTION_KEY=Q9vH7xT2Kc5LmA8RzP4sYwD1eJ6uB0NfG3hCkVtM  # <<CHANGES PER ACCOUNT>> MUST be unique + permanent per tenant (generate)
DB_TYPE=sqlite
DB_SQLITE_VACUUM_ON_STARTUP=true
GENERIC_TIMEZONE=Africa/Accra
N8N_PROXY_HOPS=1
N8N_EMAIL_MODE=smtp
N8N_SMTP_HOST=smtp.purelymail.com
N8N_SMTP_PORT=587
N8N_SMTP_USER=admin@steprotech.com
N8N_SMTP_PASS=sjkpwkscvbvkrdwzjguv
N8N_SMTP_SENDER="n8n <no-reply@steprotech.com>"
N8N_SMTP_SSL=false
N8N_SMTP_STARTTLS=true

# NOTE: compose template also references ${N8N_BASIC_AUTH_USER}/${N8N_BASIC_AUTH_PASSWORD}
# (N8N_BASIC_AUTH_ACTIVE=true) — NOT in this .env sample. Pending Steward's decision:
# leave blank (existing fleet default), or set to the account's own credentials.
